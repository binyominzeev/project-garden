# Secret used to encrypt the Auth.js session cookie.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public URL of this app (used for callback URLs).
AUTH_URL=https://projects.binjomin.hu

# Required when hosting behind a reverse proxy (not on Vercel).
AUTH_TRUST_HOST=true

# Pocket ID OIDC client credentials (from https://auth.binjomin.hu admin).
POCKET_ID_ISSUER=https://auth.binjomin.hu
POCKET_ID_CLIENT_ID=
POCKET_ID_CLIENT_SECRET=
